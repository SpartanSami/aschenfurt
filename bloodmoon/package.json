{
  "name": "bloodmoon",
  "private": true,
  "version": "0.1.0",
  "description": "BLOODMOON – Das Erbe der Finsternis. First-Person-Gothic-Fantasy-Horrorspiel für den Browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "voice:lines": "tsx tools/voice/export-lines.ts",
    "voice:generate": "node tools/voice/generate-voices.mjs",
    "sfx:generate": "node tools/voice/generate-sfx.mjs",
    "test:smoke": "node tests/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.18"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
